# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth (generate with: openssl rand -base64 48) ---
JWT_SECRET=

# --- Database: Turso (https://turso.tech) — free tier ---
# turso db create sprintly
# turso db show sprintly --url
# turso db tokens create sprintly
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Stripe (https://dashboard.stripe.com) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Create these Products/Prices in the Stripe dashboard, then paste the price IDs:
STRIPE_PRICE_INDIVIDUAL=
STRIPE_PRICE_ENTERPRISE=

# --- Web Push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@sprintly.app

# --- Cron (generate any random string, used to authorize /api/cron/*) ---
CRON_SECRET=

# --- Email: Resend (https://resend.com) — free tier (100/day, 3k/month) ---
# Password-reset and team-invite emails. Until this is set, sending fails
# silently (server logs the error, the app keeps working) rather than
# breaking those flows outright.
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account. The
# onboarding@resend.dev default only delivers to your own Resend account
# email — verify a real domain before relying on this for real users.
EMAIL_FROM="Sprintly <onboarding@resend.dev>"
